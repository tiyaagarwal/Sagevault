# @langchain/community's peer dependency range for better-sqlite3 (an optional
# peer of typeorm, which it pulls in transitively) conflicts with the version
# resolved elsewhere in the tree. This isn't a real incompatibility for how
# this app uses langchain (no sqlite-backed vector store), so relax peer
# resolution instead of forcing everyone who clones the repo to pass
# --legacy-peer-deps by hand.
legacy-peer-deps=true
